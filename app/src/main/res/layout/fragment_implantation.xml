<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/screen_implantation" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:fillViewport="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">

                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="Logo OGEF_dz" android:src="@drawable/ic_launcher_foreground" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/implantation_title" android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>

            <TextView android:id="@+id/txtImplantationLocked" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/leve_locked_message" android:textStyle="bold" android:visibility="gone" />

            <TextView android:id="@+id/txtImplantationCrsDisplay" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="CRS affiché : ---" android:textStyle="bold" />

            <TextView android:id="@+id/txtImplantationMode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="MODE : POINT" android:textStyle="bold" />

            <LinearLayout android:id="@+id/layoutRefLine" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:padding="10dp" android:background="#EEEEEE" android:visibility="gone">

                <TextView android:id="@+id/txtRefLineSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ligne : (A) - (B)" android:textStyle="bold" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">

                    <Button android:id="@+id/btnChooseRefA" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="CHOISIR A" />

                    <Button android:id="@+id/btnChooseRefB" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="CHOISIR B" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Déport fixe (m) :" android:textStyle="bold" />

                    <EditText android:id="@+id/edtRefLineFixedOffset" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:hint="0.00" android:inputType="numberDecimal" android:text="0" />

                    <RadioGroup android:id="@+id/rgRefLineSide" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="horizontal">

                        <RadioButton android:id="@+id/rbRefLineLeft" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gauche" android:checked="true" />

                        <RadioButton android:id="@+id/rbRefLineRight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Droite" />
                    </RadioGroup>
                </LinearLayout>

            </LinearLayout>

            <Button android:id="@+id/btnSelectImplantationTarget" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="CHOISIR CIBLE" />

            <Button android:id="@+id/btnChooseTargetOnMap" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CHOISIR SUR CARTE" />

            <TextView android:id="@+id/txtImplantationTargetSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/implantation_target_placeholder" android:textStyle="bold" />

            <TextView android:id="@+id/txtImplantationCurrentInct" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/implantation_current_placeholder" />

            <TextView android:id="@+id/txtImplantationTargetInct" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/implantation_target_inct_placeholder" />

            <TextView android:id="@+id/txtImplantationDeltas" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/implantation_delta_placeholder" android:textStyle="bold" />

            <TextView android:id="@+id/txtImplantationDistances" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/implantation_distance_placeholder" android:textStyle="bold" />

            <TextView android:id="@+id/txtGuidanceTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/guidance_title" android:textStyle="bold" />

            <FrameLayout android:id="@+id/layoutCompassArrow" android:layout_width="96dp" android:layout_height="96dp" android:layout_gravity="center_horizontal" android:layout_marginTop="8dp">

                <ImageView android:id="@+id/imgCompassArrow" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/guidance_compass" android:scaleType="centerInside" android:src="@drawable/fleche_boussole" />

                <TextView android:id="@+id/txtCompassDistance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:translationY="-2dp" android:text="NI" android:textColor="@color/guid_approach" android:textSize="14sp" android:textStyle="bold" android:shadowColor="#AA000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" />
            </FrameLayout>

            <LinearLayout android:id="@+id/layoutGuidanceForward" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">

                <ImageView android:id="@+id/imgForward" android:layout_width="80dp" android:layout_height="80dp" android:contentDescription="@string/guidance_forward" android:src="@drawable/ic_guidance_arrow_pro" />

                <TextView android:id="@+id/txtForwardCm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="0.00 cm" android:textSize="32sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:id="@+id/layoutGuidanceLeft" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">

                <ImageView android:id="@+id/imgLeft" android:layout_width="80dp" android:layout_height="80dp" android:contentDescription="@string/guidance_left" android:src="@drawable/ic_guidance_arrow_pro" />

                <TextView android:id="@+id/txtLeftCm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="0.00 cm" android:textSize="32sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:id="@+id/layoutGuidanceUpDown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">

                <ImageView android:id="@+id/imgUpDown" android:layout_width="60dp" android:layout_height="60dp" android:contentDescription="@string/guidance_up_down" android:src="@drawable/ic_guidance_z_pro" />

                <TextView android:id="@+id/txtDzCm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="NI" android:textSize="32sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center_vertical" android:orientation="horizontal">

                
                <ImageButton android:id="@+id/btnNavPrevImplantation" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Previous" android:elevation="8dp" android:padding="0dp" android:scaleType="fitCenter" android:scaleX="-1" android:translationZ="8dp" android:src="@drawable/fleche_terrain_soleil" />

                <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

                <ImageButton android:id="@+id/btnNavNextImplantation" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Next" android:elevation="8dp" android:padding="0dp" android:scaleType="fitCenter" android:translationZ="8dp" android:src="@drawable/fleche_terrain_soleil" />
            </LinearLayout>

            <Button android:id="@+id/btnQuitImplantation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/quit_label" />

        </LinearLayout>
    </ScrollView>

    

    