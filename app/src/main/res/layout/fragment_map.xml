<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/screen_map" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">

        <org.osmdroid.views.MapView android:id="@+id/mapView" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingTop="260dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:orientation="vertical" android:padding="8dp">

            <TextView android:id="@+id/bannerMap" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#D32F2F" android:padding="8dp" android:text="GNSS NOT READY" android:textColor="@android:color/white" android:textStyle="bold" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical">

                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="Logo OGEF_dz" android:src="@drawable/ic_launcher_foreground" />

                <TextView android:id="@+id/txtMapTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/map_title_survey" android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardMapStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="8dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">

                        <TextView android:id="@+id/txtMapFix" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Fix : ---" android:textStyle="bold" />

                        <TextView android:id="@+id/txtMapRec" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="REC ●" android:textColor="@android:color/holo_red_dark" android:textStyle="bold" android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">

                        <TextView android:id="@+id/txtMapPrecision" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Précision : ---" />

                        <TextView android:id="@+id/txtMapSats" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="Sat : ---" />
                    </LinearLayout>

                    <TextView android:id="@+id/txtMapInct" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="INCT : ---" />

                    
                    <TextView android:id="@+id/txtMapTarget" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Cible : ---" android:visibility="gone" android:textStyle="bold" />

                    <LinearLayout android:id="@+id/layoutMapDelta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal" android:visibility="gone">

                        <TextView android:id="@+id/txtMapDistance" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Distance : ---" />

                        <TextView android:id="@+id/txtMapOk" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OK" android:textStyle="bold" android:textColor="@android:color/holo_green_dark" android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/layoutMapDelta2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal" android:visibility="gone">

                        <TextView android:id="@+id/txtMapDeltaFB" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Avant/Arrière : ---" />

                        <TextView android:id="@+id/txtMapDeltaLR" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="Gauche/Droite : ---" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


        <TextView android:id="@+id/txtMapLocked" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:background="#CCFFFFFF" android:padding="16dp" android:text="@string/leve_locked_message" android:textStyle="bold" android:visibility="gone" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:padding="8dp">

            <LinearLayout android:id="@+id/layoutMapActionsSurvey" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
                
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:baselineAligned="false">

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMapAddPoint" style="@style/MapToolbarButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="Ajouter" android:hapticFeedbackEnabled="true" app:icon="@android:drawable/ic_menu_add" app:iconGravity="textTop" app:iconPadding="6dp" android:textSize="12sp" android:textAllCaps="false" android:maxLines="1" android:ellipsize="end" android:textColor="@android:color/white" app:iconTint="@android:color/white" app:backgroundTint="?attr/colorPrimary" app:iconSize="20dp" android:paddingTop="6dp" android:paddingBottom="6dp" />

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMapCenterRover" style="@style/MapToolbarButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="Centrer" android:hapticFeedbackEnabled="true" app:icon="@android:drawable/ic_menu_mylocation" app:iconGravity="textTop" app:iconPadding="6dp" android:textSize="12sp" android:textAllCaps="false" android:maxLines="1" android:ellipsize="end" android:textColor="@android:color/white" app:iconTint="@android:color/white" app:backgroundTint="?attr/colorPrimary" app:iconSize="20dp" android:paddingTop="6dp" android:paddingBottom="6dp" />

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMapFollow" style="@style/MapToolbarButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="Suivi" android:hapticFeedbackEnabled="true" app:icon="@android:drawable/ic_menu_directions" app:iconGravity="textTop" app:iconPadding="6dp" android:textSize="12sp" android:textAllCaps="false" android:maxLines="1" android:ellipsize="end" android:textColor="@android:color/white" app:iconTint="@android:color/white" app:backgroundTint="?attr/colorPrimary" app:iconSize="20dp" android:paddingTop="6dp" android:paddingBottom="6dp" />

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMapToggleTrack" style="@style/MapToolbarButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="Trace" android:hapticFeedbackEnabled="true" app:icon="@android:drawable/ic_menu_share" app:iconGravity="textTop" app:iconPadding="6dp" android:textSize="12sp" android:textAllCaps="false" android:maxLines="1" android:ellipsize="end" android:textColor="@android:color/white" app:iconTint="@android:color/white" app:backgroundTint="?attr/colorPrimary" app:iconSize="20dp" android:paddingTop="6dp" android:paddingBottom="6dp" />

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMapMore" style="@style/MapToolbarButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="Plus" android:hapticFeedbackEnabled="true" app:icon="@android:drawable/ic_menu_more" app:iconGravity="textTop" app:iconPadding="6dp" android:textSize="12sp" android:textAllCaps="false" android:maxLines="1" android:ellipsize="end" android:textColor="@android:color/white" app:iconTint="@android:color/white" app:backgroundTint="?attr/colorPrimary" app:iconSize="20dp" android:paddingTop="6dp" android:paddingBottom="6dp" />
                </LinearLayout>
</LinearLayout>

            <LinearLayout android:id="@+id/layoutMapActionsImplantation" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:visibility="gone">
                
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:baselineAligned="false">

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMapImplantCenterTarget" style="@style/MapToolbarButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="Cible" android:hapticFeedbackEnabled="true" app:icon="@android:drawable/ic_menu_myplaces" app:iconGravity="textTop" app:iconPadding="6dp" android:textSize="12sp" android:textAllCaps="false" android:maxLines="1" android:ellipsize="end" android:textColor="@android:color/white" app:iconTint="@android:color/white" app:backgroundTint="?attr/colorPrimary" app:iconSize="20dp" android:paddingTop="6dp" android:paddingBottom="6dp" />

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMapImplantCenterRover" style="@style/MapToolbarButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="Rover" android:hapticFeedbackEnabled="true" app:icon="@android:drawable/ic_menu_mylocation" app:iconGravity="textTop" app:iconPadding="6dp" android:textSize="12sp" android:textAllCaps="false" android:maxLines="1" android:ellipsize="end" android:textColor="@android:color/white" app:iconTint="@android:color/white" app:backgroundTint="?attr/colorPrimary" app:iconSize="20dp" android:paddingTop="6dp" android:paddingBottom="6dp" />

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMapImplantFollow" style="@style/MapToolbarButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="Suivi" android:hapticFeedbackEnabled="true" app:icon="@android:drawable/ic_menu_directions" app:iconGravity="textTop" app:iconPadding="6dp" android:textSize="12sp" android:textAllCaps="false" android:maxLines="1" android:ellipsize="end" android:textColor="@android:color/white" app:iconTint="@android:color/white" app:backgroundTint="?attr/colorPrimary" app:iconSize="20dp" android:paddingTop="6dp" android:paddingBottom="6dp" />

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMapImplantToggleCircle" style="@style/MapToolbarButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="Tol." android:hapticFeedbackEnabled="true" app:icon="@android:drawable/ic_menu_crop" app:iconGravity="textTop" app:iconPadding="6dp" android:textSize="12sp" android:textAllCaps="false" android:maxLines="1" android:ellipsize="end" android:textColor="@android:color/white" app:iconTint="@android:color/white" app:backgroundTint="?attr/colorPrimary" app:iconSize="20dp" android:paddingTop="6dp" android:paddingBottom="6dp" />

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMapImplantMore" style="@style/MapToolbarButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="Plus" android:hapticFeedbackEnabled="true" app:icon="@android:drawable/ic_menu_more" app:iconGravity="textTop" app:iconPadding="6dp" android:textSize="12sp" android:textAllCaps="false" android:maxLines="1" android:ellipsize="end" android:textColor="@android:color/white" app:iconTint="@android:color/white" app:backgroundTint="?attr/colorPrimary" app:iconSize="20dp" android:paddingTop="6dp" android:paddingBottom="6dp" />
                </LinearLayout>
</LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">

                <ImageButton android:id="@+id/btnNavPrevMap" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Previous" android:elevation="8dp" android:padding="0dp" android:scaleType="fitCenter" android:scaleX="-1" android:translationZ="8dp" android:src="@drawable/fleche_terrain_soleil" />

                <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

                <ImageButton android:id="@+id/btnNavNextMap" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Next" android:elevation="8dp" android:padding="0dp" android:scaleType="fitCenter" android:translationZ="8dp" android:src="@drawable/fleche_terrain_soleil" />
            </LinearLayout>

            <Button android:id="@+id/btnQuitMap" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/quit_label" />

        </LinearLayout>

    </FrameLayout>

